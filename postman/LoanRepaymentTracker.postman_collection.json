{
  "info": {
    "name": "Loan Repayment Tracker API",
    "description": "Run the requests top to bottom against a freshly started backend (seed data reloads on every restart).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// A date one week from today, for schedule requests",
          "const d = new Date(); d.setDate(d.getDate() + 7);",
          "pm.collectionVariables.set('futureDate', d.toISOString().slice(0, 10));"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "loanId",
      "value": "1"
    },
    {
      "key": "customerId",
      "value": "1"
    },
    {
      "key": "scheduleId",
      "value": ""
    },
    {
      "key": "futureDate",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login as admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Role is ADMIN\", () => pm.expect(pm.response.json().role).to.eql(\"ADMIN\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login as customer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"jmiller\",\n  \"password\": \"password1\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"Has customer and loan ids\", () => { pm.expect(body.customerId).to.be.a(\"number\"); pm.expect(body.loanId).to.be.a(\"number\"); });",
                  "pm.collectionVariables.set(\"customerId\", body.customerId);",
                  "pm.collectionVariables.set(\"loanId\", body.loanId);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login with wrong password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"nope\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 401\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "Get open loans",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/admin/loans",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "loans"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Fully repaid loans are excluded\", () => pm.response.json().forEach(l => pm.expect(Number(l.remainingBalance)).to.be.above(0)));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get loan detail",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/admin/loans/{{loanId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "loans",
                "{{loanId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Has payoff date and minimum\", () => { const b = pm.response.json(); pm.expect(b).to.have.property(\"payoffDate\"); pm.expect(b).to.have.property(\"minimumMonthlyPayment\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Get missing loan",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/admin/loans/9999",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "loans",
                "9999"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 404\", () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create loan",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/loans",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "loans"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerName\": \"Taylor Brooks\",\n  \"email\": \"taylor.brooks@example.com\",\n  \"phone\": \"660-555-0123\",\n  \"startDate\": \"2026-09-15\",\n  \"originalAmount\": 18000,\n  \"interestRate\": 5.9,\n  \"termMonths\": 72\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "const b = pm.response.json();",
                  "pm.test(\"Account was generated\", () => { pm.expect(b.username).to.be.a(\"string\"); pm.expect(b.temporaryPassword).to.have.lengthOf(10); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Create loan with missing fields",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/loans",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "loans"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerName\": \"No Email\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 400\", () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Customer",
      "item": [
        {
          "name": "Get my loan",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/customers/{{customerId}}/loan",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "customers",
                "{{customerId}}",
                "loan"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Update my details",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/customers/{{customerId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "customers",
                "{{customerId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Jordan Miller\",\n  \"email\": \"jordan.miller@example.com\",\n  \"phone\": \"816-555-0142\",\n  \"bankName\": \"Central Bank\",\n  \"routingNumber\": \"101000019\",\n  \"accountNumber\": \"4401002231\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Scheduling",
      "item": [
        {
          "name": "Minimum payment - monthly",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/loans/{{loanId}}/minimum-payment?frequency=MONTHLY",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "loans",
                "{{loanId}}",
                "minimum-payment"
              ],
              "query": [
                {
                  "key": "frequency",
                  "value": "MONTHLY"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Minimum payment - bi-weekly",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/loans/{{loanId}}/minimum-payment?frequency=BIWEEKLY",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "loans",
                "{{loanId}}",
                "minimum-payment"
              ],
              "query": [
                {
                  "key": "frequency",
                  "value": "BIWEEKLY"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"26 payments a year\", () => pm.expect(pm.response.json().paymentsPerYear).to.eql(26));"
                ]
              }
            }
          ]
        },
        {
          "name": "Minimum payment - weekly",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/loans/{{loanId}}/minimum-payment?frequency=WEEKLY",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "loans",
                "{{loanId}}",
                "minimum-payment"
              ],
              "query": [
                {
                  "key": "frequency",
                  "value": "WEEKLY"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "List schedules",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/loans/{{loanId}}/schedules",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "loans",
                "{{loanId}}",
                "schedules"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Schedule below minimum (rejected)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/loans/{{loanId}}/schedules",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "loans",
                "{{loanId}}",
                "schedules"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"frequency\": \"MONTHLY\",\n  \"amount\": 1.0,\n  \"startDate\": \"{{futureDate}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 400\", () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create schedule",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/loans/{{loanId}}/schedules",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "loans",
                "{{loanId}}",
                "schedules"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"frequency\": \"BIWEEKLY\",\n  \"amount\": 400.0,\n  \"startDate\": \"{{futureDate}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"scheduleId\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Cancel schedule",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/loans/{{loanId}}/schedules/{{scheduleId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "loans",
                "{{loanId}}",
                "schedules",
                "{{scheduleId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 204\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}